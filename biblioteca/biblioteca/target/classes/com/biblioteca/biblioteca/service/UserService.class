package com.biblioteca.biblioteca.service;

import com.biblioteca.biblioteca.model.User;
import com.biblioteca.biblioteca.repository.UserRepository;
import java.util.List;
import java.util.Optional;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service
public class UserService {
   @Autowired
   private UserRepository userRepository;

   public UserService() {
   }

   public List<User> findAll() {
      return this.userRepository.findAll();
   }

   public Optional<User> findById(Long id) {
      return this.userRepository.findById(id);
   }

   public User save(User user) {
      return (User)this.userRepository.save(user);
   }

   public void delete(Long id) {
      this.userRepository.deleteById(id);
   }

   public User update(Long id, User newUser) {
      return (User)this.userRepository.findById(id).map((user) -> {
         user.setName(newUser.getName());
         user.setEmail(newUser.getEmail());
         return (User)this.userRepository.save(user);
      }).orElseThrow();
   }

   public User patch(Long id, String name, String email) {
      return (User)this.userRepository.findById(id).map((user) -> {
         if (name != null) {
            user.setName(name);
         }

         if (email != null) {
            user.setEmail(email);
         }

         return (User)this.userRepository.save(user);
      }).orElseThrow();
   }
}
